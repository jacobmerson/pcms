@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(pcms CONFIG)
# Fusion-IO 1.x (CMake package fusionio) reads the files; prefer the one this
# package was built with.
find_dependency(fusionio CONFIG HINTS "@fusionio_DIR@")

include("${CMAKE_CURRENT_LIST_DIR}/fusionio2-targets.cmake")
check_required_components(fusionio2)
